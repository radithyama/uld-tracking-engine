# Copy to .env.local for local development. On the GCE VM these are written
# to /etc/uld/dashboard.env by deploy/gcp/deploy.sh (secrets generated per VM).

# Browser WebSocket endpoint of the realtime service (baked in at build time).
# Behind Nginx with TLS: wss://your_domain.com/ws
NEXT_PUBLIC_WS_URL=ws://localhost:8081/ws

# Auth.js
AUTH_SECRET=change-me-generate-with-openssl-rand-hex-32
AUTH_TRUST_HOST=true
# Optional Google sign-in (OAuth client with redirect URI <origin>/auth/callback/google)
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# GOOGLE_ROLE_MAP=alice@example.com:loadmaster,bob@example.com:security_auditor
# GOOGLE_DEFAULT_ROLE=ground_handler
# DEMO_LOGIN=off   # disable the one-click demo accounts

# Server-side (backend-for-frontend) access to the Go services.
# Must equal the realtime service's INTERNAL_API_SECRET.
INTERNAL_API_SECRET=dev-internal-api-secret-change-me-0123456789
REALTIME_INTERNAL_URL=http://127.0.0.1:8081
INGEST_INTERNAL_URL=http://127.0.0.1:8080
SIM_CONTROL_URL=http://127.0.0.1:8090
SANDBOX_API_KEY=dev-web-sandbox-key-5c2e81f0a9
